{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hgmf-hg43-replicate-receipt.schema.json",
  "title": "HGMF HG43 independent replicate receipt",
  "type": "object",
  "required": [
    "replicate_id",
    "carrier",
    "acquisition_hash",
    "independent_cluster_id",
    "independence_certificate_hash",
    "ancestry_hash",
    "calibration_or_reference_hashes",
    "created_before_holdout",
    "holdout_values_accessed_before_arming"
  ],
  "properties": {
    "replicate_id": {"type": "string", "minLength": 1},
    "carrier": {"enum": ["magnetism", "adsorption"]},
    "acquisition_hash": {"type": "string", "minLength": 1},
    "independent_cluster_id": {"type": "string", "minLength": 1},
    "independence_certificate_hash": {"type": "string", "minLength": 1},
    "ancestry_hash": {"type": "string", "minLength": 1},
    "calibration_or_reference_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "created_before_holdout": {"const": true},
    "holdout_values_accessed_before_arming": {"const": false}
  }
}
